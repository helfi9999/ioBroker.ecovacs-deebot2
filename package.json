{
  "name": "iobroker.ecovacs-deebot2",
  "version": "0.10.112",
  "description": "Multi-robot Ecovacs adapter for ioBroker",
  "main": "build/src/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test build/test/*.test.js",
    "check": "npm test",
    "pack:adapter": "npm run check && npm pack",
    "test:package": "mocha test/package.cjs --timeout 60000",
    "test:integration": "npm run build && mocha test/integration.cjs --timeout 600000",
    "prepack": "npm run build",
    "test:security": "npm audit --omit=dev --audit-level=low",
    "test:security:all": "npm audit --audit-level=low",
    "lint": "eslint src test"
  },
  "keywords": [
    "ioBroker",
    "ecovacs",
    "deebot",
    "vacuum",
    "smart-home"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "@cypress/request": "^4.0.1",
    "@iobroker/adapter-core": "^3.4.3",
    "@xmldom/xmldom": "^0.9.12",
    "axios": "^1.21.1",
    "chalk": "^4.1.2",
    "debug": "^4.4.3",
    "ltx": "^3.1.2",
    "lzma": "^2.3.2",
    "md5.js": "^1.3.5",
    "minimist": "^1.2.8",
    "mqtt": "^5.14.1",
    "node-xmpp-core": "^5.0.9",
    "qbox": "^0.1.7",
    "uniqid": "^5.4.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.2"
  },
  "files": [
    "build",
    "admin",
    "io-package.json",
    "LICENSE",
    "README.md",
    "src",
    "test",
    "tsconfig.json",
    "docs",
    "licenses",
    "THIRD_PARTY_NOTICES.md",
    "vendor"
  ],
  "author": {
    "name": "Thomas H.",
    "url": "https://github.com/helfi9999",
    "email": "helfi9999@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helfi9999/ioBroker.ecovacs-deebot2.git"
  },
  "bugs": {
    "url": "https://github.com/helfi9999/ioBroker.ecovacs-deebot2/issues"
  },
  "homepage": "https://github.com/helfi9999/ioBroker.ecovacs-deebot2#readme",
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9",
    "node-forge": "1.4.3"
  }
}
